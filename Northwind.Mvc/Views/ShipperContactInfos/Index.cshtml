@model IEnumerable<Northwind.Mvc.Models.ShipperContactInfo>
@using Northwind.Mvc.Models

@{
    ViewData["Title"] = "Shipper Contact Infos";
    var secondList = ViewBag.SecondList as List<ShipperContactInfo>;
}
<div class="container mt-4">
<h2>Shipper Contact Infos</h2>

<a asp-action="Create" class="btn btn-purple mb-3">Create New</a>


<table class="table table-striped table-hover table-bordered shadow">
    <thead>
        <tr>
            <th>Shipper</th>
            <th>Email</th>
            <th>Website</th>
            <th>Phone</th>
            <th>Address</th>
            <th>City</th>
            <th>Country</th>
            <th>Postal Code</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Shipper.CompanyName</td>
                <td>@item.Email</td>
                <td>@item.Website</td>
                <td>@item.Phone</td>
                <td>@item.Address</td>
                <td>@item.City</td>
                <td>@item.Country</td>
                <td>@item.PostalCode</td>
                <td>
    <a asp-action="Edit" asp-route-id="@item.ContactInfoId" class="btn btn-sm btn-warning">Edit</a>
    <a asp-action="Delete" asp-route-id="@item.ContactInfoId" class="btn btn-sm btn-danger">Delete</a>
</td>
            </tr>
        }
    </tbody>
</table>

<br />
<br />

<h2>Shipper Contact Infos Copy</h2>

<table class="table table-striped table-hover table-bordered shadow">
    <thead>
        <tr>
            <th>Shipper</th>
            <th>Email</th>
            <th>Website</th>
            <th>Phone</th>
            <th>Address</th>
            <th>City</th>
            <th>Country</th>
            <th>Postal Code</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (secondList != null)
        {
            @foreach (var item in secondList)
            {
                <tr>
                    <td>@item.Shipper.CompanyName</td>
                    <td>@item.Email</td>
                    <td>@item.Website</td>
                    <td>@item.Phone</td>
                    <td>@item.Address</td>
                    <td>@item.City</td>
                    <td>@item.Country</td>
                    <td>@item.PostalCode</td>
                    <td>
    <a asp-action="Edit" asp-route-id="@item.ContactInfoId" class="btn btn-sm btn-warning">Edit</a>

    <form asp-action="SoftDelete" method="post" style="display:inline;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@item.ContactInfoId" />
        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
    </form>
</td>
                </tr>
            }
        }
    </tbody>
</table>
<style>
    .btn-purple {
        background-color: #6f42c1;
        color: white;
        border: none;
    }

    .btn-purple:hover {
        background-color: #5a32a3;
        color: white;
    }
</style>
</div>