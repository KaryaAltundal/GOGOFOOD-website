@model IEnumerable<Northwind.Mvc.Models.ShipperContactInfo>

@{
    ViewData["Title"] = "Shipper Contact Infos";
}

<h2>Shipper Contact Infos</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Shipper</th>
            <th>Email</th>
            <th>Website</th>
            <th>Phone</th>
            <th>Address</th>
            <th>City</th>
            <th>Country</th>
            <th>Postal Code</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Shipper.CompanyName</td>
                <td>@item.Email</td>
                <td>@item.Website</td>
                <td>@item.Phone</td>
                <td>@item.Address</td>
                <td>@item.City</td>
                <td>@item.Country</td>
                <td>@item.PostalCode</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ContactInfoId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@item.ContactInfoId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<br />
<br />

