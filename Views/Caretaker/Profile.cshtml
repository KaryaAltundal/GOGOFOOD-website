@model GOGOFOOD.Models.Caretaker

@{
    ViewData["Title"] = "Restaurant Profile";
    var mapsApiKey = ViewBag.GoogleMapsApiKey as string ?? "";
    var startLat = Model.Latitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "39.9208";
    var startLng = Model.Longitude?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "32.8541";
}

<div class="page-title">
    <h1>Restaurant Profile 🏪</h1>
    <p>Update your restaurant information and delivery location.</p>
</div>

@if (TempData["ProfileMessage"] != null)
{
    <div class="alert-modern alert-success-modern">
        @TempData["ProfileMessage"]
    </div>
}

@if (TempData["ProfileError"] != null)
{
    <div class="alert-modern alert-danger-modern">
        @TempData["ProfileError"]
    </div>
}

<div class="location-two-column">
    <div class="modern-form-card location-form-card">
        <form asp-controller="Caretaker" asp-action="Profile" method="post" class="vertical-form" id="restaurantLocationForm">
            <input type="hidden" asp-for="CaretakerId" />
            <input type="hidden" id="Latitude" name="latitude" value="@startLat" />
            <input type="hidden" id="Longitude" name="longitude" value="@startLng" />

            <div class="form-group-modern">
                <label>Caterer Name</label>
                <input asp-for="Name" placeholder="Example: GOGO BUBBLE TEA" required />
            </div>

            <div class="form-group-modern">
                <label>Restaurant Name</label>
                <input asp-for="RestaurantName" placeholder="Example: GOGO BUBBLE TEA" required />
            </div>

            <div class="form-group-modern">
                <label>City</label>
                <input asp-for="City" id="City" placeholder="Example: Ankara" required />
            </div>

            <div class="form-group-modern">
                <label>District</label>
                <input asp-for="District" id="District" placeholder="Example: Yenimahalle" required />
            </div>

            <div class="form-group-modern">
                <label>Neighborhood</label>
                <input asp-for="Neighborhood" id="Neighborhood" placeholder="Example: Batıkent" required />
            </div>

            <div class="form-group-modern">
                <label>Street</label>
                <input asp-for="Street" id="Street" placeholder="Example: Atatürk Boulevard" />
            </div>

            <div class="form-group-modern">
                <label>Address Detail</label>
                <input asp-for="AddressDetail" id="AddressDetail" placeholder="Apartment, building, door number..." />
            </div>

            <button type="button" class="btn-outline-pink location-map-button" onclick="showTypedAddressOnMap()">
                Show Address on Map
            </button>

            <button type="submit" class="btn-pink">
                Save Profile
            </button>
        </form>
    </div>

    <div class="location-map-card">
        <div class="location-map-heading">
            <h3>Choose Restaurant Location 🗺️</h3>
            <p>Drag the marker or click on the map. The restaurant address fields will update automatically.</p>
        </div>

        @if (string.IsNullOrWhiteSpace(mapsApiKey))
        {
            <div class="alert-modern alert-danger-modern">
                Google Maps API key is missing. Add it to appsettings.json under GoogleMaps:ApiKey.
            </div>
        }

        <div id="locationMap" class="location-map"></div>
        <small class="map-help-text">Selected coordinates are saved silently in the form.</small>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Address))
{
    <div class="saved-address-card">
        <h3>Saved Restaurant Address ✅</h3>
        <p>@Model.Address</p>

        @if (Model.Latitude != null && Model.Longitude != null)
        {
            <small>Map location: @Model.Latitude, @Model.Longitude</small>
        }
    </div>
}

@section Scripts {
    @if (!string.IsNullOrWhiteSpace(mapsApiKey))
    {
        <script>
            let map;
            let marker;
            let geocoder;

            const defaultLat = parseFloat('@startLat');
            const defaultLng = parseFloat('@startLng');

            function initLocationMap() {
                geocoder = new google.maps.Geocoder();

                const startPosition = {
                    lat: defaultLat,
                    lng: defaultLng
                };

                map = new google.maps.Map(document.getElementById('locationMap'), {
                    center: startPosition,
                    zoom: 15
                });

                marker = new google.maps.Marker({
                    position: startPosition,
                    map: map,
                    draggable: true,
                    title: 'Drag me to change restaurant location'
                });

                updateHiddenCoordinates(startPosition.lat, startPosition.lng);

                marker.addListener('dragend', function () {
                    const position = marker.getPosition();
                    updateLocationFromMap(position.lat(), position.lng());
                });

                map.addListener('click', function (event) {
                    marker.setPosition(event.latLng);
                    updateLocationFromMap(event.latLng.lat(), event.latLng.lng());
                });
            }

            function updateHiddenCoordinates(lat, lng) {
                document.getElementById('Latitude').value = lat.toFixed(7);
                document.getElementById('Longitude').value = lng.toFixed(7);
            }

            function updateLocationFromMap(lat, lng) {
                updateHiddenCoordinates(lat, lng);

                geocoder.geocode({ location: { lat: lat, lng: lng } }, function (results, status) {
                    if (status === 'OK' && results[0]) {
                        fillAddressFields(results[0]);
                    }
                });
            }

            function showTypedAddressOnMap() {
                const address = [
                    document.getElementById('AddressDetail').value,
                    document.getElementById('Street').value,
                    document.getElementById('Neighborhood').value,
                    document.getElementById('District').value,
                    document.getElementById('City').value,
                    'Turkey'
                ].filter(x => x && x.trim() !== '').join(', ');

                if (address.trim() === '') {
                    alert('Please write an address first.');
                    return;
                }

                geocoder.geocode({ address: address }, function (results, status) {
                    if (status === 'OK' && results[0]) {
                        const location = results[0].geometry.location;

                        map.setCenter(location);
                        marker.setPosition(location);

                        updateHiddenCoordinates(location.lat(), location.lng());
                    } else {
                        alert('Address could not be found on Google Maps.');
                    }
                });
            }

            function fillAddressFields(result) {
                const components = result.address_components;

                const city = getComponent(components, ['administrative_area_level_1']);
                const district = getComponent(components, ['administrative_area_level_2', 'locality']);
                const neighborhood = getComponent(components, ['neighborhood', 'sublocality', 'sublocality_level_1']);
                const street = getComponent(components, ['route']);
                const streetNumber = getComponent(components, ['street_number']);

                if (city) document.getElementById('City').value = city;
                if (district) document.getElementById('District').value = district;
                if (neighborhood) document.getElementById('Neighborhood').value = neighborhood;
                if (street) document.getElementById('Street').value = street;
                if (streetNumber) document.getElementById('AddressDetail').value = streetNumber;
            }

            function getComponent(components, types) {
                for (let i = 0; i < components.length; i++) {
                    for (let j = 0; j < types.length; j++) {
                        if (components[i].types.includes(types[j])) {
                            return components[i].long_name;
                        }
                    }
                }

                return '';
            }
        </script>

        <script async defer src="https://maps.googleapis.com/maps/api/js?key=@mapsApiKey&callback=initLocationMap"></script>
    }
}