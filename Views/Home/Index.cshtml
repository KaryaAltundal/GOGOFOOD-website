@{
    ViewData["Title"] = "Home Page";
}

<div class="home-hero-modern">
    <div class="home-hero-content">
        <span class="home-badge">Fresh • Fast • Modern</span>

        <h1>
    Welcome to
    <span class="home-brand-title">
        <span class="brand-gogo">GOGO</span><span class="brand-food">FOOD</span>
    </span>
</h1>

        <p>
            <span class="brand-logo inline-brand">
                <span class="brand-gogo">GOGO</span><span class="brand-food">FOOD</span>
            </span>
            is a modern catering and food ordering platform that connects users
            with nearby restaurants. You can explore meals, customize your order,
            complete a simulated payment, track your orders, and rate both meals
            and restaurants.
        </p>

        <div class="home-actions">
            <a asp-controller="MenuItem" asp-action="Index" class="btn-pink">
                Explore Menu
            </a>

            <a asp-controller="Account" asp-action="Register" class="btn-outline-pink join-brand-btn">
    Join <span class="brand-gogo">GOGO</span><span class="brand-food">FOOD</span>
</a>
        </div>
    </div>

    <div class="home-hero-card">
        <h3>Why Choose 
            <span class="brand-logo inline-brand">
                <span class="brand-gogo">GOGO</span><span class="brand-food">FOOD</span>
            </span>?
        </h3>

        <div class="home-feature">
            <span>🍽️</span>
            <div>
                <strong>Rich Menu Options</strong>
                <p>Browse meals from different restaurants and choose custom ingredients.</p>
            </div>
        </div>

        <div class="home-feature">
            <span>📍</span>
            <div>
                <strong>Location Based Filtering</strong>
                <p>Find restaurants near your address with distance-based filtering.</p>
            </div>
        </div>

        <div class="home-feature">
            <span>⭐</span>
            <div>
                <strong>Rating System</strong>
                <p>Rate meals and restaurants after completed orders.</p>
            </div>
        </div>
    </div>
</div>

<div class="home-section">
    <div class="home-section-title">
        <h2>How It Works</h2>
        <p>Order your favorite meals in a few simple steps.</p>
    </div>

    <div class="home-steps-grid">
        <div class="home-step-card">
            <span>1</span>
            <h3>Choose Meal</h3>
            <p>Explore the menu and select the food you want.</p>
        </div>

        <div class="home-step-card">
            <span>2</span>
            <h3>Customize</h3>
            <p>Add extra ingredients and personalize your order.</p>
        </div>

        <div class="home-step-card">
            <span>3</span>
            <h3>Pay</h3>
            <p>Complete the simulated payment process safely.</p>
        </div>

        <div class="home-step-card">
            <span>4</span>
            <h3>Rate</h3>
            <p>Share your experience by rating meals and restaurants.</p>
        </div>
    </div>
</div>