<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GOGOFOOD</title>
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar-custom">
            <a asp-controller="Home" asp-action="Index" class="logo">
                GOGO<span>FOOD</span>
            </a>

            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index">🏠Home</a></li>
                <li><a asp-controller="MenuItem" asp-action="Index">🍽Menu</a></li>

                @if (!string.IsNullOrEmpty(Context.Session.GetString("UserEmail")) 
                    && Context.Session.GetString("UserRole") != "Caretaker")
                {
                    <li><a asp-controller="Cart" asp-action="Index">🛒Cart</a></li>
                    <li><a asp-controller="Order" asp-action="Index">📦Orders</a></li>
                }

                @if (Context.Session.GetString("UserRole") == "Caretaker")
                {
                    <li><a asp-controller="MenuItem" asp-action="Create">➕Add Menu</a></li>
                    <li><a asp-controller="CustomizationOption" asp-action="Create">Customization</a></li>
                }
            </ul>

            <div class="nav-right">
                @if (string.IsNullOrEmpty(Context.Session.GetString("UserEmail")))
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-login">Login</a>
                    <a asp-controller="Account" asp-action="Register" class="btn-signup">Register</a>
                }
                else
                {
                    <span class="welcome-user">
                        Hello, @Context.Session.GetString("UserName")
                    </span>

                    <a asp-controller="Account" asp-action="Logout" class="btn-logout">Logout</a>
                }
            </div>
        </nav>
    </header>

    <div class="page-wrapper">
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <p>© 2026 GOGOFOOD - All Rights Reserved</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>