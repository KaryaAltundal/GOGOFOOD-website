<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GOGOFOOD</title>
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    @{
        var currentRole = Context.Session.GetString("UserRole");
        var currentEmail = Context.Session.GetString("UserEmail");
        var currentName = Context.Session.GetString("UserName");
        var isLoggedIn = !string.IsNullOrEmpty(currentEmail);

        var displayName = currentName;

        
if (currentRole == "Admin")
{
    displayName = "Admin";
}
else if (currentRole == "Caretaker")
{
    displayName = "Caterer";
}
else if (!string.IsNullOrEmpty(displayName))
{
    displayName = displayName
        .Replace("Caretaker", "Caterer")
        .Replace("caretaker", "Caterer");
}
    }

    <header>
        <nav class="navbar-custom">
            <a asp-controller="Home" asp-action="Index" class="logo brand-logo">
                <span class="brand-gogo">GOGO</span><span class="brand-food">FOOD</span>
            </a>

            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index">🏠 Home</a></li>

                @if (!isLoggedIn || currentRole == "User")
                {
                    <li><a asp-controller="MenuItem" asp-action="Index">🏪 Caterers</a></li>
                }

                @if (isLoggedIn && currentRole == "User")
                {
                    <li><a asp-controller="Cart" asp-action="Index">🛒 Cart</a></li>
                    <li><a asp-controller="Order" asp-action="Index">📦 Orders</a></li>
                    <li><a asp-controller="User" asp-action="Location">📍 Location</a></li>
                }

                @if (currentRole == "Caretaker")
                {
                    <li><a asp-controller="MenuItem" asp-action="Index">🍽 My Menus</a></li>
                    <li><a asp-controller="MenuItem" asp-action="Create">➕ Add Menu</a></li>
                    <li><a asp-controller="Order" asp-action="Index">📦 Orders</a></li>
                    <li><a asp-controller="Caretaker" asp-action="Profile">🏪 Caterer Profile</a></li>
                }

                @if (currentRole == "Admin")
                {
                    <li><a asp-controller="Order" asp-action="Index">📦 Orders</a></li>
                    <li><a asp-controller="Admin" asp-action="Users">👥 Users</a></li>
                    <li><a asp-controller="Admin" asp-action="Logs">📋 Logs</a></li>
                }
            </ul>

            <div class="nav-right">
                @if (!isLoggedIn)
                {
                    <a asp-controller="Account" asp-action="Login" class="btn-login">Login</a>
                    <a asp-controller="Account" asp-action="Register" class="btn-signup">Register</a>
                }
                else
                {
                    <span class="welcome-user">
                        👋 @displayName
                    </span>

                    <a asp-controller="Account" asp-action="Logout" class="btn-logout">Logout</a>
                }
            </div>
        </nav>
    </header>

    <div class="page-wrapper">
        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-modern">
        <div class="footer-grid">
            <div class="footer-brand">
                <h2 class="brand-logo footer-logo">
                    <span class="brand-gogo">GOGO</span><span class="brand-food">FOOD</span>
                </h2>

                <p>
                    <span class="brand-logo inline-brand">
                        <span class="brand-gogo">GOGO</span><span class="brand-food">FOOD</span>
                    </span>
                    is a modern catering platform for events, companies and large groups.
                    Users can choose caterers, build full event menus and order for flexible guest counts.
                </p>

                <div class="footer-contact">
                    <p>📧 info@gogofood.com</p>
                    <p>📞 +90 555 123 45 67</p>
                    <p>📍 Istanbul, Turkey</p>
                </div>
            </div>

            <div class="footer-column">
                <h3>Quick Links</h3>
                <a asp-controller="Home" asp-action="Index">Home</a>

                @if (!isLoggedIn || currentRole == "User")
                {
                    <a asp-controller="MenuItem" asp-action="Index">Caterers</a>
                }

                @if (currentRole == "User")
                {
                    <a asp-controller="Cart" asp-action="Index">Cart</a>
                    <a asp-controller="Order" asp-action="Index">Orders</a>
                    <a asp-controller="User" asp-action="Location">Location</a>
                }

                @if (currentRole == "Caretaker")
                {
                    <a asp-controller="MenuItem" asp-action="Index">My Menus</a>
                    <a asp-controller="MenuItem" asp-action="Create">Add Menu</a>
                    <a asp-controller="Order" asp-action="Index">Orders</a>
                    <a asp-controller="Caretaker" asp-action="Profile">Caterer Profile</a>
                }

                @if (currentRole == "Admin")
                {
                    <a asp-controller="Order" asp-action="Index">Admin Orders</a>
                    <a asp-controller="Admin" asp-action="Users">Users</a>
                    <a asp-controller="Admin" asp-action="Logs">System Logs</a>
                }
            </div>

            <div class="footer-column">
                <h3>About Us</h3>
                <p>
                    Our mission is to make catering planning easier for events of every size.
                    We focus on clear menus, flexible quantities, and smooth order management.
                </p>
            </div>

            <div class="footer-column">
                <h3>Follow Us</h3>
                <p>Stay updated on social media.</p>

                <div class="social-links social-icon-links">
                    <a href="#" aria-label="Instagram">
                        <svg viewBox="0 0 24 24" class="social-svg">
                            <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 4.2A3.8 3.8 0 1 1 12 15.8a3.8 3.8 0 0 1 0-7.6Zm0 2A1.8 1.8 0 1 0 12 13.8a1.8 1.8 0 0 0 0-3.6ZM17.4 7a1 1 0 1 1-1 1a1 1 0 0 1 1-1Z" />
                        </svg>
                        Instagram
                    </a>

                    <a href="#" aria-label="Twitter">
                        <svg viewBox="0 0 24 24" class="social-svg">
                            <path d="M18.9 2.8h3.1l-6.8 7.8l8 10.6h-6.3l-4.9-6.4l-5.6 6.4H3.2l7.3-8.4L2.8 2.8h6.4l4.4 5.9l5.3-5.9Zm-1.1 16.5h1.7L8.3 4.6H6.5l11.3 14.7Z" />
                        </svg>
                        Twitter
                    </a>

                    <a href="#" aria-label="Facebook">
                        <svg viewBox="0 0 24 24" class="social-svg">
                            <path d="M14 8.5V6.8c0-.8.5-1 1.1-1H18V2h-3.9C10.7 2 9 4.1 9 6.5v2H6v4h3V22h5v-9.5h3.4l.6-4H14Z" />
                        </svg>
                        Facebook
                    </a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            © 2026
            <span class="brand-logo footer-bottom-logo">
                <span class="brand-gogo">GOGO</span><span class="brand-food">FOOD</span>
            </span>
            . All rights reserved.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>