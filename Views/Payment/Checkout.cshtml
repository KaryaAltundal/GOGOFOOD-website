@model List<GOGOFOOD.Models.CartItem>

@{
    ViewData["Title"] = "Payment";
    var totalPrice = Model.Sum(x => x.TotalPrice);
}

<div class="payment-page">
    <div class="payment-left-card">
        <div class="payment-heading">
            <span class="payment-badge">Secure Catering Checkout</span>
            <h1>Payment</h1>
            <p>Review your catering order and complete your payment securely.</p>
        </div>

        <h2>Catering Order Summary</h2>

        <div class="payment-table-wrapper">
            <table class="payment-table">
                <thead>
                    <tr>
                        <th>Menu Option</th>
                        <th>Category</th>
                        <th>Customization</th>
                        <th>People</th>
                        <th>Total</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="payment-item-info">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <div class="payment-item-placeholder">🍽️</div>
                                    }

                                    <div>
                                        <strong>@item.Name</strong>

                                        @if (!string.IsNullOrWhiteSpace(item.RestaurantName))
                                        {
                                            <small>@item.RestaurantName</small>
                                        }
                                    </div>
                                </div>
                            </td>

                            <td>@item.Category</td>
                            <td>@item.Customization</td>
                            <td>@item.Quantity</td>
                            <td class="payment-price">₺@item.TotalPrice.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="payment-total-box">
            <span>Total Catering Price</span>
            <strong>₺@totalPrice.ToString("N2")</strong>
        </div>

        <div class="payment-note">
            🔒 Your catering order will be confirmed after payment.
        </div>
    </div>

    <div class="payment-right-card">
        <h2>Card Information</h2>

        @if (ViewBag.PaymentError != null)
        {
            <div class="alert-modern alert-danger-modern">
                @ViewBag.PaymentError
            </div>
        }

        <div id="paymentClientError" class="alert-modern alert-danger-modern" style="display:none;"></div>

        <form asp-controller="Payment"
              asp-action="CompletePayment"
              method="post"
              class="payment-form"
              id="paymentForm"
              autocomplete="off">

            @Html.AntiForgeryToken()

            <div class="payment-form-group">
                <label>Card Holder Name</label>
                <input type="text"
                       id="cardHolder"
                       name="cardHolder"
                       placeholder="Name Surname"
                       autocomplete="off"
                       required />
            </div>

            <div class="payment-form-group">
                <label>Card Number</label>
                <input type="text"
                       id="cardNumber"
                       name="cardNumber"
                       placeholder="1234567890123456"
                       inputmode="numeric"
                       autocomplete="off"
                       required
                       minlength="16"
                       maxlength="16" />
            </div>

            <div class="payment-row">
                <div class="payment-form-group">
                    <label>Expiration Date</label>
                    <input type="text"
                           id="expirationDate"
                           name="expirationDate"
                           placeholder="MM/YY"
                           inputmode="numeric"
                           autocomplete="off"
                           required
                           maxlength="5" />
                </div>

                <div class="payment-form-group">
                    <label>CVV</label>
                    <input type="password"
                           id="cvv"
                           name="cvv"
                           placeholder="123"
                           inputmode="numeric"
                           autocomplete="off"
                           required
                           minlength="3"
                           maxlength="3" />
                </div>
            </div>

            <button type="submit" class="payment-button">
                Complete Payment ₺@totalPrice.ToString("N2")
            </button>

            <p class="payment-secure-text">
                ✅ Secure payment confirmation
            </p>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const paymentForm = document.getElementById("paymentForm");
        const paymentClientError = document.getElementById("paymentClientError");

        const cardHolderInput = document.getElementById("cardHolder");
        const cardNumberInput = document.getElementById("cardNumber");
        const expirationDateInput = document.getElementById("expirationDate");
        const cvvInput = document.getElementById("cvv");

        cardHolderInput.addEventListener("input", function () {
            this.value = this.value
                .replace(/[^a-zA-ZçÇğĞıİöÖşŞüÜ\s]/g, "")
                .replace(/\s{2,}/g, " ");
        });

        cardNumberInput.addEventListener("input", function () {
            this.value = this.value
                .replace(/\D/g, "")
                .slice(0, 16);
        });

        expirationDateInput.addEventListener("input", function () {
            let value = this.value
                .replace(/\D/g, "")
                .slice(0, 4);

            if (value.length >= 3) {
                value = value.slice(0, 2) + "/" + value.slice(2);
            }

            this.value = value;
        });

        cvvInput.addEventListener("input", function () {
            this.value = this.value
                .replace(/\D/g, "")
                .slice(0, 3);
        });

        paymentForm.addEventListener("submit", function (event) {
            const validationMessage = validatePaymentForm();

            if (validationMessage !== "") {
                event.preventDefault();
                showPaymentError(validationMessage);
            }
        });

        function validatePaymentForm() {
            const cardHolder = cardHolderInput.value.trim();
            const cardNumber = cardNumberInput.value.trim();
            const expirationDate = expirationDateInput.value.trim();
            const cvv = cvvInput.value.trim();

            if (cardHolder.length < 3) {
                return "Please enter the card holder name.";
            }

            if (!/^[a-zA-ZçÇğĞıİöÖşŞüÜ\s]+$/.test(cardHolder)) {
                return "Card holder name can only contain letters.";
            }

            if (!/^\d{16}$/.test(cardNumber)) {
                return "Card number must contain exactly 16 digits.";
            }

            if (!/^\d{2}\/\d{2}$/.test(expirationDate)) {
                return "Expiration date must be in MM/YY format.";
            }

            if (!isExpirationDateValid(expirationDate)) {
                return "The card expiration date is invalid or expired.";
            }

            if (!/^\d{3}$/.test(cvv)) {
                return "CVV must contain exactly 3 digits.";
            }

            return "";
        }

        function isExpirationDateValid(expirationDate) {
            const parts = expirationDate.split("/");
            const month = parseInt(parts[0], 10);
            const year = parseInt(parts[1], 10);

            if (isNaN(month) || isNaN(year)) {
                return false;
            }

            if (month < 1 || month > 12) {
                return false;
            }

            const fullYear = 2000 + year;
            const expirationLimit = new Date(fullYear, month, 1);
            const today = new Date();

            return expirationLimit > today;
        }

        function showPaymentError(message) {
            paymentClientError.textContent = message;
            paymentClientError.style.display = "block";
            paymentClientError.scrollIntoView({ behavior: "smooth", block: "center" });
        }
    </script>
}