@model List<GOGOFOOD.Models.Order>

@{
    ViewData["Title"] = "Orders";
    var role = Context.Session.GetString("UserRole");
}

<div class="page-title">
    <h1>Orders 📦</h1>
    <p>Review completed orders and leave ratings for meals or restaurants.</p>
</div>

@if (TempData["RatingMessage"] != null)
{
    <div class="alert-modern alert-success-modern">
        @TempData["RatingMessage"]
    </div>
}

<div class="filter-card">
    <form asp-controller="Order" asp-action="Index" method="get" class="filter-form">
        <div class="filter-input-group">
            <label>Search orders</label>
            <input type="text"
                   name="searchText"
                   value="@ViewBag.SearchText"
                   placeholder="Search customer, meal or status" />
        </div>

        <button type="submit" class="btn-pink">
            Filter Orders
        </button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h3>No orders found</h3>
        <p>Your completed orders will appear here.</p>
    </div>
}
else
{
    <div class="orders-list-modern">
        @foreach (var order in Model)
        {
            <div class="order-card-modern">
                <div class="order-card-header">
                    <div>
                        <h2>Completed Order</h2>
                        <p>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</p>
                    </div>

                    <div class="order-status-pill">
                        @order.Status
                    </div>
                </div>

                <div class="order-info-row">
                    <div class="order-info-box">
                        <span>Total</span>
                        <strong>₺@order.TotalPrice</strong>
                    </div>

                    @if (order.User != null)
                    {
                        <div class="order-info-box">
                            <span>Customer</span>
                            <strong>@order.User.Name</strong>
                            <small>@order.User.Email</small>
                        </div>
                    }

                    <div class="order-info-box">
                        <span>Items</span>
                        <strong>@(order.OrderItems != null ? order.OrderItems.Sum(x => x.Quantity) : 0)</strong>
                    </div>
                </div>

                @if (order.OrderItems != null)
                {
                    <div class="order-items-modern">
                        @foreach (var item in order.OrderItems)
                        {
                            <div class="order-item-modern">
                                <div class="order-item-image-box">
                                    @if (!string.IsNullOrEmpty(item.MenuItem?.ImageUrl))
                                    {
                                        <img src="@item.MenuItem.ImageUrl" alt="@item.MenuItem.Name" />
                                    }
                                    else
                                    {
                                        <div class="order-image-placeholder">🍽️</div>
                                    }
                                </div>

                                <div class="order-item-main">
                                    <h3>@item.MenuItem?.Name</h3>

                                    @if (item.MenuItem?.Caretaker != null)
                                    {
                                        <p class="order-restaurant-name">🏪 @item.MenuItem.Caretaker.RestaurantName</p>
                                    }
                                    else
                                    {
                                        <p class="order-restaurant-name">No restaurant assigned</p>
                                    }

                                    <p class="order-customization">
                                        <strong>Custom:</strong> @item.CustomizationName
                                    </p>
                                </div>

                                <div class="order-item-prices">
                                    <div>
                                        <span>Quantity</span>
                                        <strong>@item.Quantity</strong>
                                    </div>

                                    <div>
                                        <span>Unit Price</span>
                                        <strong>₺@item.UnitPrice</strong>
                                    </div>

                                    <div>
                                        <span>Custom Price</span>
                                        <strong>₺@item.CustomizationPrice</strong>
                                    </div>
                                </div>

                                <div class="order-rating-actions">
                                    @if (role == "User" && order.Status == "Completed")
                                    {
                                        <a asp-controller="Rating"
                                           asp-action="AddMenuItemRating"
                                           asp-route-orderId="@order.OrderId"
                                           asp-route-menuItemId="@item.MenuItemId"
                                           class="btn-outline-pink">
                                            Rate Meal
                                        </a>

                                        @if (item.MenuItem?.CaretakerId != null)
                                        {
                                            <a asp-controller="Rating"
                                               asp-action="AddCaretakerRating"
                                               asp-route-orderId="@order.OrderId"
                                               asp-route-caretakerId="@item.MenuItem.CaretakerId"
                                               class="btn-soft-rating">
                                                Rate Restaurant
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <span class="order-no-action">No action</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
{
    <div class="pagination-modern">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <a asp-controller="Order"
               asp-action="Index"
               asp-route-page="@i"
               asp-route-searchText="@ViewBag.SearchText"
               class="@(ViewBag.CurrentPage == i ? "page-active" : "")">
                @i
            </a>
        }
    </div>
}