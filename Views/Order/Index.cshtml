@model List<GOGOFOOD.Models.Order>

@using System.Globalization

@{
    ViewData["Title"] = "Orders";

    var role = Context.Session.GetString("UserRole");
    var isAdmin = role == "Admin";

    var searchText = ViewBag.SearchText as string ?? "";
    var statusFilter = ViewBag.StatusFilter as string ?? "";
    var startDate = ViewBag.StartDate as string ?? "";
    var endDate = ViewBag.EndDate as string ?? "";

    string minTotalValue = ViewBag.MinTotal != null
        ? Convert.ToDecimal(ViewBag.MinTotal).ToString("0.##", CultureInfo.InvariantCulture)
        : "";

    string maxTotalValue = ViewBag.MaxTotal != null
        ? Convert.ToDecimal(ViewBag.MaxTotal).ToString("0.##", CultureInfo.InvariantCulture)
        : "";

    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
}

<div class="page-title @(isAdmin ? "admin-page-title" : "")">
    @if (isAdmin)
    {
        <h1>Admin Orders Panel 📦</h1>
        <p>Monitor completed orders, customers, caterers, locations and order totals.</p>
    }
    else
    {
        <h1>Orders 📦</h1>
        <p>Review completed catering orders and leave ratings for meals or caterers.</p>
    }
</div>

@if (TempData["RatingMessage"] != null)
{
    <div class="alert-modern alert-success-modern">
        @TempData["RatingMessage"]
    </div>
}

@if (isAdmin)
{
    <div class="admin-stats-grid">
        <div class="admin-stat-card">
            <span>Total Orders</span>
            <strong>@ViewBag.AdminTotalOrders</strong>
        </div>

        <div class="admin-stat-card">
            <span>Total Revenue</span>
            <strong>₺@String.Format("{0:0.00}", ViewBag.AdminTotalRevenue)</strong>
        </div>

        <div class="admin-stat-card">
            <span>Total Items Sold</span>
            <strong>@ViewBag.AdminTotalItems</strong>
        </div>

        <div class="admin-stat-card">
            <span>Average Order</span>
            <strong>₺@String.Format("{0:0.00}", ViewBag.AdminAverageOrderValue)</strong>
        </div>

        <div class="admin-stat-card">
            <span>Completed Orders</span>
            <strong>@ViewBag.AdminCompletedOrders</strong>
        </div>

        <div class="admin-stat-card">
            <span>Today's Orders</span>
            <strong>@ViewBag.AdminTodayOrders</strong>
        </div>

        <div class="admin-stat-card">
            <span>Unique Customers</span>
            <strong>@ViewBag.AdminUniqueCustomers</strong>
        </div>

        <div class="admin-stat-card">
            <span>Active Caterers</span>
            <strong>@ViewBag.AdminUniqueRestaurants</strong>
        </div>
    </div>
}

<div class="admin-order-filter-card">
    <form asp-controller="Order" asp-action="Index" method="get" class="admin-order-filter-form">
        <div class="admin-filter-field admin-filter-search">
            <label>Search</label>
            <input type="text"
                   name="searchText"
                   value="@searchText"
                   placeholder="Customer, menu, caterer or status" />
        </div>

        <div class="admin-filter-field">
            <label>Status</label>
            <select name="statusFilter">
                @if (string.IsNullOrWhiteSpace(statusFilter))
                {
                    <option value="" selected>All</option>
                }
                else
                {
                    <option value="">All</option>
                }

                @if (statusFilter == "Completed")
                {
                    <option value="Completed" selected>Completed</option>
                }
                else
                {
                    <option value="Completed">Completed</option>
                }

                @if (statusFilter == "Pending")
                {
                    <option value="Pending" selected>Pending</option>
                }
                else
                {
                    <option value="Pending">Pending</option>
                }

                @if (statusFilter == "Cancelled")
                {
                    <option value="Cancelled" selected>Cancelled</option>
                }
                else
                {
                    <option value="Cancelled">Cancelled</option>
                }
            </select>
        </div>

        <div class="admin-filter-field">
            <label>Min Total</label>
            <input type="number"
                   step="0.01"
                   name="minTotal"
                   value="@minTotalValue"
                   placeholder="0" />
        </div>

        <div class="admin-filter-field">
            <label>Max Total</label>
            <input type="number"
                   step="0.01"
                   name="maxTotal"
                   value="@maxTotalValue"
                   placeholder="1000" />
        </div>

        <div class="admin-filter-field">
            <label>Start Date</label>
            <input type="date"
                   name="startDate"
                   value="@startDate" />
        </div>

        <div class="admin-filter-field">
            <label>End Date</label>
            <input type="date"
                   name="endDate"
                   value="@endDate" />
        </div>

        <div class="admin-filter-actions">
            <button type="submit">
                Search
            </button>

            <a asp-controller="Order"
               asp-action="Index"
               class="admin-clear-filter-btn">
                Clear
            </a>
        </div>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h3>No orders found</h3>

        @if (isAdmin)
        {
            <p>No order records match your current filter.</p>
        }
        else
        {
            <p>Your completed catering orders will appear here.</p>
        }
    </div>
}
else if (isAdmin)
{
    <div class="admin-orders-shell">
        <div class="admin-orders-list">
            @foreach (var order in Model)
            {
                var totalItems = order.OrderItems != null
                    ? order.OrderItems.Sum(x => x.Quantity)
                    : 0;

                var restaurants = order.OrderItems != null
                    ? order.OrderItems
                        .Where(x => x.MenuItem?.Caretaker != null)
                        .Select(x => x.MenuItem!.Caretaker!)
                        .GroupBy(x => x.CaretakerId)
                        .Select(x => x.First())
                        .ToList()
                    : new List<GOGOFOOD.Models.Caretaker>();

                <div class="admin-order-card">
                    <div class="admin-order-top">
                        <div>
                            <h2>Order #@order.OrderId</h2>
                            <p>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</p>
                        </div>

                        <div class="admin-order-status">
                            @order.Status
                        </div>
                    </div>

                    <div class="admin-order-meta-grid">
                        <div class="admin-meta-box">
                            <span>Total</span>
                            <strong>₺@String.Format("{0:0.00}", order.TotalPrice)</strong>
                            <small>@totalItems people / item count recorded</small>
                        </div>

                        <div class="admin-meta-box">
                            <span>Customer</span>

                            @if (order.User != null)
                            {
                                <strong>@order.User.Name</strong>
                                <small>@order.User.Email</small>
                            }
                            else
                            {
                                <strong>Unknown Customer</strong>
                                <small>User record is not available.</small>
                            }
                        </div>

                        <div class="admin-meta-box">
                            <span>Customer Location</span>

                            @if (order.User != null)
                            {
                                <strong>@order.User.City / @order.User.District</strong>

                                <small class="admin-location-text">
                                    @order.User.AddressDetail
                                    @if (!string.IsNullOrWhiteSpace(order.User.Street))
                                    {
                                        <text>, @order.User.Street</text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(order.User.Neighborhood))
                                    {
                                        <text>, @order.User.Neighborhood</text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(order.User.District))
                                    {
                                        <text>, @order.User.District</text>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(order.User.City))
                                    {
                                        <text>, @order.User.City</text>
                                    }
                                </small>

                                @if (order.User.Latitude != null && order.User.Longitude != null)
                                {
                                    <small class="admin-coordinate">
                                        Lat: @order.User.Latitude | Lng: @order.User.Longitude
                                    </small>
                                }
                                else
                                {
                                    <small class="admin-coordinate">
                                        Coordinates not entered.
                                    </small>
                                }
                            }
                            else
                            {
                                <strong>Unknown</strong>
                                <small>Location is not available.</small>
                            }
                        </div>
                    </div>

                    <div class="admin-items-table-wrapper">
                        <table class="admin-items-table">
                            <thead>
                                <tr>
                                    <th>Menu Option</th>
                                    <th>Caterer</th>
                                    <th>Caterer Location</th>
                                    <th>Customization</th>
                                    <th>People</th>
                                    <th>Price / Person</th>
                                    <th>Custom / Person</th>
                                    <th>Line Total</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (order.OrderItems != null)
                                {
                                    @foreach (var item in order.OrderItems)
                                    {
                                        var caretaker = item.MenuItem?.Caretaker;
                                        var lineTotal = (item.UnitPrice + item.CustomizationPrice) * item.Quantity;

                                        <tr>
                                            <td>
                                                <strong>@item.MenuItem?.Name</strong>
                                                <div class="admin-location-text">
                                                    @item.MenuItem?.Description
                                                </div>
                                            </td>

                                            <td>
                                                @if (caretaker != null)
                                                {
                                                    <strong>@caretaker.RestaurantName</strong>
                                                    <div class="admin-location-text">
                                                        @caretaker.Name
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span>Not assigned</span>
                                                }
                                            </td>

                                            <td>
                                                @if (caretaker != null)
                                                {
                                                    <div class="admin-location-text">
                                                        @caretaker.AddressDetail
                                                        @if (!string.IsNullOrWhiteSpace(caretaker.Street))
                                                        {
                                                            <text>, @caretaker.Street</text>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(caretaker.Neighborhood))
                                                        {
                                                            <text>, @caretaker.Neighborhood</text>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(caretaker.District))
                                                        {
                                                            <text>, @caretaker.District</text>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(caretaker.City))
                                                        {
                                                            <text>, @caretaker.City</text>
                                                        }
                                                    </div>

                                                    @if (caretaker.Latitude != null && caretaker.Longitude != null)
                                                    {
                                                        <span class="admin-coordinate">
                                                            Lat: @caretaker.Latitude | Lng: @caretaker.Longitude
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="admin-coordinate">
                                                            Coordinates not entered.
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span>Caterer location is not available.</span>
                                                }
                                            </td>

                                            <td>@item.CustomizationName</td>
                                            <td>@item.Quantity</td>
                                            <td>₺@String.Format("{0:0.00}", item.UnitPrice)</td>
                                            <td>₺@String.Format("{0:0.00}", item.CustomizationPrice)</td>
                                            <td class="admin-money">
                                                ₺@String.Format("{0:0.00}", lineTotal)
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (restaurants.Count > 0)
                    {
                        <div class="admin-order-meta-grid">
                            <div class="admin-meta-box">
                                <span>Caterer Count</span>
                                <strong>@restaurants.Count</strong>
                                <small>Unique caterer(s) included in this order.</small>
                            </div>

                            <div class="admin-meta-box">
                                <span>Caterers</span>
                                <strong>@string.Join(", ", restaurants.Select(x => x.RestaurantName))</strong>
                                <small>Useful for checking multi-caterer order records.</small>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="orders-list-modern">
        @foreach (var order in Model)
        {
            <div class="order-card-modern">
                <div class="order-card-header">
                    <div>
                        <h2>Completed Order</h2>
                        <p>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</p>
                    </div>

                    <div class="order-status-pill">
                        @order.Status
                    </div>
                </div>

                <div class="order-info-row">
                    <div class="order-info-box">
                        <span>Total</span>
                        <strong>₺@String.Format("{0:0.00}", order.TotalPrice)</strong>
                    </div>

                    @if (order.User != null)
                    {
                        <div class="order-info-box">
                            <span>Customer</span>
                            <strong>@order.User.Name</strong>
                            <small>@order.User.Email</small>
                        </div>
                    }

                    <div class="order-info-box">
                        <span>People / Items</span>
                        <strong>@(order.OrderItems != null ? order.OrderItems.Sum(x => x.Quantity) : 0)</strong>
                    </div>
                </div>

                @if (order.OrderItems != null)
                {
                    <div class="order-items-modern">
                        @foreach (var item in order.OrderItems)
                        {
                            <div class="order-item-modern">
                                <div class="order-item-image-box">
                                    @if (!string.IsNullOrEmpty(item.MenuItem?.ImageUrl))
                                    {
                                        <img src="@item.MenuItem.ImageUrl" alt="@item.MenuItem.Name" />
                                    }
                                    else
                                    {
                                        <div class="order-image-placeholder">
                                            🍽️
                                        </div>
                                    }
                                </div>

                                <div class="order-item-main">
                                    <h3>@item.MenuItem?.Name</h3>

                                    @if (item.MenuItem?.Caretaker != null)
                                    {
                                        <p class="order-restaurant-name">
                                            🏪 @item.MenuItem.Caretaker.RestaurantName
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="order-restaurant-name">
                                            No caterer assigned
                                        </p>
                                    }

                                    <p class="order-customization">
                                        <strong>Custom:</strong> @item.CustomizationName
                                    </p>
                                </div>

                                <div class="order-item-prices">
                                    <div>
                                        <span>People Count</span>
                                        <strong>@item.Quantity</strong>
                                    </div>

                                    <div>
                                        <span>Price / Person</span>
                                        <strong>₺@String.Format("{0:0.00}", item.UnitPrice)</strong>
                                    </div>

                                    <div>
                                        <span>Custom / Person</span>
                                        <strong>₺@String.Format("{0:0.00}", item.CustomizationPrice)</strong>
                                    </div>
                                </div>

                                <div class="order-rating-actions">
                                    @if (role == "User" && order.Status == "Completed")
                                    {
                                        <a asp-controller="Rating"
                                           asp-action="AddMenuItemRating"
                                           asp-route-orderId="@order.OrderId"
                                           asp-route-menuItemId="@item.MenuItemId"
                                           class="btn-outline-pink">
                                            Rate Menu
                                        </a>

                                        @if (item.MenuItem?.CaretakerId != null)
                                        {
                                            <a asp-controller="Rating"
                                               asp-action="AddCaretakerRating"
                                               asp-route-orderId="@order.OrderId"
                                               asp-route-caretakerId="@item.MenuItem.CaretakerId"
                                               class="btn-soft-rating">
                                                Rate Caterer
                                            </a>
                                        }
                                    }
                                    else
                                    {
                                        <span class="order-no-action">
                                            No action
                                        </span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@await Html.PartialAsync("_SmartPagination", new GOGOFOOD.Models.ViewModels.PaginationViewModel
{
    CurrentPage = currentPage,
    TotalPages = totalPages,
    ControllerName = "Order",
    ActionName = "Index",
    SearchText = searchText,
    StatusFilter = statusFilter,
    MinTotal = ViewBag.MinTotal,
    MaxTotal = ViewBag.MaxTotal,
    StartDate = startDate,
    EndDate = endDate
})