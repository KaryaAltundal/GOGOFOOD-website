@model List<GOGOFOOD.Models.Order>

@{
    ViewData["Title"] = "Orders";
    var role = Context.Session.GetString("UserRole");
}

<h1>Orders 📦</h1>

@if (TempData["RatingMessage"] != null)
{
    <p style="color:green; font-weight:bold;">@TempData["RatingMessage"]</p>
}

@if (Model.Count == 0)
{
    <p>No orders found.</p>
}
else
{
    @foreach (var order in Model)
    {
        <div class="card" style="margin-bottom:20px;">
            <h3>Order #@order.OrderId</h3>

            <p><strong>Date:</strong> @order.OrderDate.ToString("dd.MM.yyyy HH:mm")</p>
            <p><strong>Status:</strong> @order.Status</p>
            <p><strong>Total:</strong> @order.TotalPrice</p>

            @if (order.User != null)
            {
                <p><strong>User:</strong> @order.User.Name (@order.User.Email)</p>
            }

            <table>
                <tr>
                    <th>Menu Item</th>
                    <th>Caretaker / Restaurant</th>
                    <th>Quantity</th>
                    <th>Unit Price</th>
                    <th>Customization</th>
                    <th>Customization Price</th>
                    <th>Menu Rating</th>
                    <th>Caretaker Rating</th>
                </tr>

                @if (order.OrderItems != null)
                {
                    foreach (var item in order.OrderItems)
                    {
                        <tr>
                            <td>@item.MenuItem?.Name</td>

                            <td>
                                @if (item.MenuItem?.Caretaker != null)
                                {
                                    <span>@item.MenuItem.Caretaker.RestaurantName</span>
                                }
                                else
                                {
                                    <span>No caretaker assigned</span>
                                }
                            </td>

                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice</td>
                            <td>@item.CustomizationName</td>
                            <td>@item.CustomizationPrice</td>

                            <td>
                                @if (role == "User" && order.Status == "Completed")
                                {
                                    <a asp-controller="Rating"
                                       asp-action="AddMenuItemRating"
                                       asp-route-orderId="@order.OrderId"
                                       asp-route-menuItemId="@item.MenuItemId">
                                        Rate Menu Item
                                    </a>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>

                            <td>
                                @if (role == "User" &&
                                     order.Status == "Completed" &&
                                     item.MenuItem?.CaretakerId != null)
                                {
                                    <a asp-controller="Rating"
                                       asp-action="AddCaretakerRating"
                                       asp-route-orderId="@order.OrderId"
                                       asp-route-caretakerId="@item.MenuItem.CaretakerId">
                                        Rate Caretaker
                                    </a>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </table>
        </div>
    }
}