@model List<GOGOFOOD.Models.CartItem>

@{
    ViewData["Title"] = "Cart";
}

<h1>Your Cart 🛒</h1>

@if (Model.Count == 0)
{
    <p>Your cart is empty.</p>
}
else
{
    <table border="1" cellpadding="10">
        <tr>
            <th>Menu Item</th>
            <th>Price</th>
            <th>Customization</th>
            <th>Customization Price</th>
            <th>Quantity</th>
            <th>Total</th>
            <th>Action</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>@item.Customization</td>
                <td>@item.CustomizationPrice</td>

                <td>
                    <a asp-controller="Cart"
                       asp-action="DecreaseQuantity"
                       asp-route-id="@item.MenuItemId">-</a>

                    @item.Quantity

                    <a asp-controller="Cart"
                       asp-action="IncreaseQuantity"
                       asp-route-id="@item.MenuItemId">+</a>
                </td>

                <td>@item.TotalPrice</td>

                <td>
                    <a asp-controller="Cart"
                       asp-action="RemoveItem"
                       asp-route-id="@item.MenuItemId">
                        Remove
                    </a>
                </td>
            </tr>
        }
    </table>

    <h3>Cart Total: @Model.Sum(x => x.TotalPrice)</h3>

    <a asp-controller="Payment" asp-action="Checkout">
        Proceed to Payment
    </a>
}