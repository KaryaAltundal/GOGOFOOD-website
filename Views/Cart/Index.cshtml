@model List<GOGOFOOD.Models.CartItem>

@{
    ViewData["Title"] = "Cart";
}

<div class="page-title cart-page-title">
    <h1>Your Catering Cart 🛒</h1>
    <p>Review your selected catering menus and guest counts before payment.</p>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h3>Your catering cart is empty</h3>
        <p>Add catering menu options from a caterer to see them here.</p>

        <a asp-controller="MenuItem" asp-action="Index" class="btn-pink">
            Go to Catering Menus
        </a>
    </div>
}
else
{
    <div class="cart-layout-modern">
        <div class="cart-items-list">
            @foreach (var item in Model)
            {
                <div class="cart-item-card">
                    <div class="cart-item-image-box">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" class="cart-item-image" />
                        }
                        else
                        {
                            <div class="cart-image-placeholder">
                                🍽️
                            </div>
                        }
                    </div>

                    <div class="cart-item-info">
                        <span class="cart-category-pill">@item.Category</span>

                        <h3>@item.Name</h3>

                        @if (!string.IsNullOrWhiteSpace(item.RestaurantName))
                        {
                            <p class="cart-caterer-name">🏪 @item.RestaurantName</p>
                        }

                        <p class="cart-customization">
                            <strong>Custom:</strong> @item.Customization
                        </p>

                        <div class="cart-price-row">
                            <span>Price Per Person</span>
                            <strong>₺@item.Price</strong>
                        </div>

                        <div class="cart-price-row">
                            <span>Customization Per Person</span>
                            <strong>₺@item.CustomizationPrice</strong>
                        </div>
                    </div>

                    <div class="cart-quantity-box">
                        <p>People Count</p>

                        <div class="quantity-controls">
                            <a asp-controller="Cart"
                               asp-action="DecreaseQuantity"
                               asp-route-cartItemKey="@item.CartItemKey"
                               class="quantity-btn">
                                −
                            </a>

                            <span>@item.Quantity</span>

                            <a asp-controller="Cart"
                               asp-action="IncreaseQuantity"
                               asp-route-cartItemKey="@item.CartItemKey"
                               class="quantity-btn">
                                +
                            </a>
                        </div>

                        <small>Buttons change by 100 people.</small>
                    </div>

                    <div class="cart-total-box">
                        <p>Total</p>
                        <h4>₺@item.TotalPrice</h4>

                        <a asp-controller="Cart"
                           asp-action="RemoveItem"
                           asp-route-cartItemKey="@item.CartItemKey"
                           class="cart-remove-link">
                            Remove
                        </a>
                    </div>
                </div>
            }
        </div>

        <div class="cart-summary-card">
            <h2>Catering Summary</h2>

            <div class="summary-line">
                <span>Menu Options</span>
                <strong>@Model.Count</strong>
            </div>

            <div class="summary-line">
                <span>Total People Count</span>
                <strong>@Model.Sum(x => x.Quantity)</strong>
            </div>

            <div class="summary-line">
                <span>Subtotal</span>
                <strong>₺@Model.Sum(x => x.TotalPrice)</strong>
            </div>

            <div class="summary-total">
                <span>Total</span>
                <strong>₺@Model.Sum(x => x.TotalPrice)</strong>
            </div>

            <a asp-controller="Payment" asp-action="Checkout" class="btn-pink checkout-btn">
                Proceed to Payment
            </a>

            <a asp-controller="MenuItem" asp-action="Index" class="continue-shopping-link">
                Continue Choosing Menus
            </a>
        </div>
    </div>
}