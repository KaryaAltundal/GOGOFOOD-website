@{
    ViewData["Title"] = "Reset Password";
}

<div class="auth-page-clean">
    <div class="auth-card-clean reset-password-card">
        <div class="two-factor-icon">📩</div>

        <h1>Reset Password</h1>

        <p class="forgot-password-desc">
            We sent a 6-digit password reset code to:
        </p>

        <div class="two-factor-email">
            @ViewBag.Email
        </div>

        @if (TempData["ResetMessage"] != null)
        {
            <div class="alert-modern alert-success-modern">
                @TempData["ResetMessage"]
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert-modern alert-danger-modern">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account" asp-action="ResetPassword" method="post" class="auth-form-clean reset-password-form">
            @Html.AntiForgeryToken()

            <div class="auth-field-clean">
                <label>Reset Code</label>
                <input type="text"
                       name="code"
                       maxlength="6"
                       placeholder="Enter 6-digit code"
                       autocomplete="off"
                       required />
            </div>

            <div class="auth-field-clean">
                <label>New Password</label>
                <input type="password"
                       name="newPassword"
                       placeholder="Enter new password"
                       autocomplete="off"
                       required />
            </div>

            <div class="auth-field-clean">
                <label>Confirm New Password</label>
                <input type="password"
                       name="confirmPassword"
                       placeholder="Confirm new password"
                       autocomplete="off"
                       required />
            </div>

            <div class="reset-button-center">
                <button type="submit" class="btn-pink reset-main-btn">
                    Change Password
                </button>
            </div>
        </form>

        <form asp-controller="Account" asp-action="ResendPasswordResetCode" method="post" class="reset-resend-form">
            @Html.AntiForgeryToken()

            <button type="submit" class="btn-outline-pink reset-resend-btn">
                Resend Code
            </button>
        </form>

        <div class="reset-back-wrapper">
            <a asp-controller="Account" asp-action="Login" class="reset-back-link">
                ← Back to Login
            </a>
        </div>
    </div>
</div>