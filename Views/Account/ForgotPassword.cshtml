@{
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-page-clean">
    <div class="auth-card-clean">
        <div class="two-factor-icon">🔐</div>

        <h1>Forgot Password</h1>

        <p class="forgot-password-desc">
            Enter your email address and we will send you a 6-digit password reset code.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="alert-modern alert-danger-modern">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="auth-form-clean">
            @Html.AntiForgeryToken()

            <div class="auth-field-clean">
                <label>Email</label>
                <input type="email"
                       name="email"
                       placeholder="Enter your email"
                       autocomplete="off"
                       required />
            </div>

            <button type="submit" class="btn-pink auth-submit-clean">
                Send Reset Code
            </button>

            <p class="auth-link-text-clean">
                Remember your password?
                <a asp-controller="Account" asp-action="Login">Back to Login</a>
            </p>
        </form>
    </div>
</div>