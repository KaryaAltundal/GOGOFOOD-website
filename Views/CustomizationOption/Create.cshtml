@model GOGOFOOD.Models.CustomizationOption

@{
    ViewData["Title"] = "Add Custom Ingredient";
}

<div class="custom-option-page">
    <div class="custom-option-card">
        <div class="custom-option-header">
            <h1>Add Custom Ingredient</h1>
            <p>Add an extra ingredient or customization option for this menu item.</p>
        </div>

        <form asp-controller="CustomizationOption" asp-action="Create" method="post" class="custom-option-form">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="MenuItemId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="custom-option-field">
                <label asp-for="Name">Ingredient Name</label>
                <input asp-for="Name" placeholder="Example: Extra sauce, sesame topping, no salt" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="custom-option-field">
                <label asp-for="ExtraPrice">Extra Price</label>
                <input asp-for="ExtraPrice" type="number" step="0.01" min="0" placeholder="Example: 15.00" />
                <span asp-validation-for="ExtraPrice" class="text-danger"></span>
            </div>

            <div class="custom-option-actions">
                <button type="submit" class="btn-pink">
                    Save
                </button>

                <a asp-controller="MenuItem" asp-action="Index" class="btn-outline-pink">
                    Back to Menu
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}