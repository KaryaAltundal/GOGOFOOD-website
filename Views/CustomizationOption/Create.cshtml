@model GOGOFOOD.Models.CustomizationOption

@{
    ViewData["Title"] = "Add Custom Ingredient";
}

<h2>Add Custom Ingredient</h2>

<form asp-controller="CustomizationOption" asp-action="Create" method="post">
    <input type="hidden" name="MenuItemId" value="@ViewBag.MenuItemId" />

    <div>
        <label>Ingredient Name</label>
        <input name="Name" />
    </div>

    <div>
        <label>Extra Price</label>
        <input name="ExtraPrice" type="number" step="0.01" />
    </div>

    <button type="submit">Save</button>
</form>

<br />

<a asp-controller="MenuItem" asp-action="Index">Back to Menu</a>