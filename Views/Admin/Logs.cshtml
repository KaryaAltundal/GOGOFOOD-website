@model List<GOGOFOOD.Models.SystemLog>

@{
    ViewData["Title"] = "System Logs";

    var searchText = ViewBag.SearchText as string ?? "";
    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
}

<div class="page-title">
    <h1>System Logs 🧾</h1>
    <p>Track system activities, user actions, and important events.</p>
</div>

<div class="compact-filter-card">
    <form asp-controller="Admin" asp-action="Logs" method="get" class="compact-filter-form">
        <input type="text"
               name="searchText"
               value="@searchText"
               placeholder="Search event, message, email or role" />

        <button type="submit">
            Search
        </button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <h3>No logs found</h3>
        <p>System activities will appear here.</p>
    </div>
}
else
{
    <div class="table-modern-wrapper">
        <table class="table-modern">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Event Type</th>
                    <th>Message</th>
                    <th>User Email</th>
                    <th>User Role</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>@log.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@log.EventType</td>
                        <td>@log.Message</td>
                        <td>@log.UserEmail</td>
                        <td>@log.UserRole</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@await Html.PartialAsync("_SmartPagination", new GOGOFOOD.Models.ViewModels.PaginationViewModel
{
    CurrentPage = currentPage,
    TotalPages = totalPages,
    ControllerName = "Admin",
    ActionName = "Logs",
    SearchText = searchText
})