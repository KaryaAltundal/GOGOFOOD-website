@model List<GOGOFOOD.Models.SystemLog>

@{
    ViewData["Title"] = "System Logs";
}

<h1>System Logs</h1>

@if (Model.Count == 0)
{
    <p>No logs found.</p>
}
else
{
    <table>
        <tr>
            <th>Date</th>
            <th>Event Type</th>
            <th>Message</th>
            <th>User Email</th>
            <th>User Role</th>
        </tr>

        @foreach (var log in Model)
        {
            <tr>
                <td>@log.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@log.EventType</td>
                <td>@log.Message</td>
                <td>@log.UserEmail</td>
                <td>@log.UserRole</td>
            </tr>
        }
    </table>
}