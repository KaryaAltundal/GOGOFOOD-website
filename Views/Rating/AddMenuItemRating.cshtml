@model GOGOFOOD.Models.MenuItemRating

@{
    ViewData["Title"] = "Rate Menu";

    var orderId = ViewBag.OrderId;
    var menuItemId = ViewBag.MenuItemId;
    var menuItem = ViewBag.MenuItem as GOGOFOOD.Models.MenuItem;

    var selectedRating = Model != null && Model.RatingValue > 0 ? Model.RatingValue : 5;

    var ratingCount = ViewBag.RatingCount != null ? (int)ViewBag.RatingCount : 0;
    var ratingAverage = ViewBag.RatingAverage != null ? Convert.ToDouble(ViewBag.RatingAverage) : 0;
}

<div class="page-title">
    <h1>Rate Menu ⭐</h1>
    <p>Select a star rating and write your experience about this catering menu option.</p>
</div>

@if (TempData["RatingMessage"] != null)
{
    <div class="alert-modern alert-success-modern">
        @TempData["RatingMessage"]
    </div>
}

<div class="rating-page-layout rating-page-single">
    <div class="rating-form-card">
        @if (menuItem != null)
        {
            <div class="rating-menu-preview">
                <div class="rating-menu-image">
                    @if (!string.IsNullOrEmpty(menuItem.ImageUrl))
                    {
                        <img src="@menuItem.ImageUrl" alt="@menuItem.Name" />
                    }
                    else
                    {
                        <span>🍽️</span>
                    }
                </div>

                <div>
                    <span class="rating-category-label">@menuItem.Category</span>
                    <h2>@menuItem.Name</h2>

                    @if (menuItem.Caretaker != null)
                    {
                        <p>🏪 @menuItem.Caretaker.RestaurantName</p>
                    }

                    <div class="rating-summary-box">
                        @if (ratingCount > 0)
                        {
                            <strong>⭐ @ratingAverage.ToString("0.0") / 5</strong>
                            <span>@ratingCount rating(s)</span>
                        }
                        else
                        {
                            <strong>⭐ No rating yet</strong>
                            <span>Be the first to rate this menu.</span>
                        }
                    </div>
                </div>
            </div>
        }

        <form asp-controller="Rating"
              asp-action="AddMenuItemRating"
              method="post"
              class="rating-form-modern">

            @Html.AntiForgeryToken()

            <input type="hidden" name="orderId" value="@orderId" />
            <input type="hidden" name="menuItemId" value="@menuItemId" />

            <div class="rating-field">
                <label>Your Rating</label>

                <select name="ratingValue" required>
                    @for (int i = 5; i >= 1; i--)
                    {
                        if (selectedRating == i)
                        {
                            <option value="@i" selected>@i ⭐</option>
                        }
                        else
                        {
                            <option value="@i">@i ⭐</option>
                        }
                    }
                </select>
            </div>

            <div class="rating-field">
                <label>Your Comment</label>
                <textarea name="comment"
                          rows="5"
                          placeholder="Write your comment about this menu...">@Model?.Comment</textarea>
            </div>

            <div class="rating-action-row">
                <button type="submit" class="btn-pink">
                    Save Rating
                </button>

                <a asp-controller="Rating"
                   asp-action="Reviews"
                   asp-route-menuItemId="@menuItemId"
                   class="btn-outline-pink">
                    View Reviews
                </a>

                <a asp-controller="Order"
                   asp-action="Index"
                   class="btn-outline-pink">
                    Back to Orders
                </a>
            </div>
        </form>
    </div>
</div>