@model GOGOFOOD.Models.MenuItem

@{
    ViewData["Title"] = "Edit Catering Menu";
    var categories = ViewBag.Categories as string[] ?? new[] { "Starter", "Main Course", "Dessert", "Drink" };
}

<div class="page-title">
    <h1>Edit Catering Menu ✏️</h1>
    <p>Update this catering menu option, category, price per person and photo.</p>
</div>

<div class="modern-form-card">
    @if (ViewBag.ImageError != null)
    {
        <div class="alert-modern alert-danger-modern">
            @ViewBag.ImageError
        </div>
    }

    <form asp-controller="MenuItem" asp-action="Edit" method="post" enctype="multipart/form-data" class="vertical-form">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="MenuItemId" />

        <div class="form-group-modern">
            <label>Menu Option Name</label>
            <input asp-for="Name" placeholder="Example: Premium Main Course Set" required />
        </div>

        <div class="form-group-modern">
            <label>Category</label>
            <select asp-for="Category" required>
                @foreach (var category in categories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </div>

        <div class="form-group-modern">
            <label>Description</label>
            <input asp-for="Description" placeholder="Example: Catering option for corporate events" required />
        </div>

        <div class="form-group-modern">
            <label>Price Per Person</label>
            <input asp-for="Price" type="number" step="0.01" min="0.01" placeholder="Example: 250" required />
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="current-image-box">
                <label>Current Photo</label>
                <img src="@Model.ImageUrl" alt="@Model.Name" />
            </div>
        }

        <div class="form-group-modern">
            <label>Change Menu Photo</label>
            <input type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
            <small>If you do not choose a new photo, the current photo will stay. Maximum size: 2 MB.</small>
        </div>

        <button type="submit" class="btn-pink">
            Save Changes
        </button>

        <a asp-controller="MenuItem" asp-action="Index" class="btn-outline-pink">
            Cancel
        </a>
    </form>
</div>