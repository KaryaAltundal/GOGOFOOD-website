@model List<GOGOFOOD.Models.MenuItem>

@{
    ViewData["Title"] = "Menu";
    var role = Context.Session.GetString("UserRole");
}

<h1>Our Menu</h1>

@foreach (var item in Model)
{
    <div class="card" style="margin-bottom:20px;">
        <h3>@item.Name</h3>
        <p>@item.Description</p>
        <p><strong>Price:</strong> @item.Price</p>

        @if (item.MenuItemRatings != null && item.MenuItemRatings.Count > 0)
        {
            <p>
                <strong>Menu Item Rating:</strong>
                ⭐ @item.MenuItemRatings.Average(x => x.RatingValue).ToString("0.0") / 5
                (@item.MenuItemRatings.Count reviews)
            </p>
        }
        else
        {
            <p><strong>Menu Item Rating:</strong> No ratings yet</p>
        }

        @if (item.Caretaker != null)
        {
            <p>
                <strong>Restaurant:</strong> @item.Caretaker.RestaurantName
            </p>

            @if (item.Caretaker.CaretakerRatings != null && item.Caretaker.CaretakerRatings.Count > 0)
            {
                <p>
                    <strong>Caretaker Rating:</strong>
                    ⭐ @item.Caretaker.CaretakerRatings.Average(x => x.RatingValue).ToString("0.0") / 5
                    (@item.Caretaker.CaretakerRatings.Count reviews)
                </p>
            }
            else
            {
                <p><strong>Caretaker Rating:</strong> No ratings yet</p>
            }
        }
        else
        {
            <p><strong>Restaurant:</strong> No caretaker assigned</p>
        }

        @if (role == "Caretaker")
        {
            <a asp-controller="CustomizationOption"
               asp-action="Create"
               asp-route-menuItemId="@item.MenuItemId">
                Add Custom Ingredient
            </a>

            <br />

            <a asp-controller="CustomizationOption"
               asp-action="Index"
               asp-route-menuItemId="@item.MenuItemId">
                Manage Custom Ingredients
            </a>
        }
        else
        {
            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                <input type="hidden" name="id" value="@item.MenuItemId" />
                <input type="hidden" name="name" value="@item.Name" />
                <input type="hidden" name="price" value="@item.Price" />

                <label>Customization</label>

                <select name="customizationOptionId">
                    <option value="0">No customization</option>

                    @if (item.CustomizationOptions != null)
                    {
                        foreach (var option in item.CustomizationOptions)
                        {
                            <option value="@option.CustomizationOptionId">
                                @option.Name (+@option.ExtraPrice)
                            </option>
                        }
                    }
                </select>

                <button type="submit">Add to Cart</button>
            </form>
        }
    </div>
}