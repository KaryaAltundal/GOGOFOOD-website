@model GOGOFOOD.Models.MenuItem

<h2>Create Menu Item</h2>

<form asp-controller="MenuItem" asp-action="Create" method="post">
    <div>
        <label>Name</label>
        <input asp-for="Name" />
    </div>

    <div>
        <label>Price</label>
        <input asp-for="Price" type="number" step="0.01" />
    </div>

    <div>
        <label>Description</label>
        <input asp-for="Description" />
    </div>

    <button type="submit">Save</button>
</form>